APP_ENV=production
FRONTEND_ORIGIN=https://your-app.vercel.app

DATABASE_URL=postgresql+asyncpg://user:password@host:5432/deltadrop
DATABASE_URL_SYNC=postgresql://user:password@host:5432/deltadrop

JWT_SECRET_KEY=change-this-to-a-very-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

ADMIN_EMAIL=admin@deltadrop.in
ADMIN_PASSWORD=YourSecureAdminPassword123!

# Mailtrap (development)
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your_mailtrap_user
# SMTP_PASS=your_mailtrap_pass

# Gmail App Password (production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM_EMAIL=youraddress@gmail.com
SMTP_FROM_NAME=DeltaDrop

PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_RESET_URL=https://your-app.vercel.app/reset-password

GEMINI_API_KEY=
GOOGLE_CLIENT_ID=

SCRAPER_HEADLESS=true
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT_MS=30000
SCRAPER_CONCURRENCY=6

REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=900

ML_MODEL_PATH=app/ml/models/price_predictor.pkl
ML_MIN_HISTORY_POINTS=7

SCRAPER_API_KEY=
SERPAPI_API_KEY=
SCRAPE_DO_API_KEY=

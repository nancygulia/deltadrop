# Root backend URL — do NOT include /api/v1 here, it is added automatically
VITE_API_BASE_URL=https://your-backend.onrender.com

# Legacy fallback (used if VITE_API_BASE_URL is not set)
VITE_API_BASE=/api/v1

# Google OAuth (for Sign In with Google — public client ID, safe for frontend)
VITE_GOOGLE_CLIENT_ID=your_client_id

# NOTE: VITE_GEMINI_API_KEY has been REMOVED.
# All AI features are handled securely by the backend.
# Set GEMINI_API_KEY in the backend .env instead.
